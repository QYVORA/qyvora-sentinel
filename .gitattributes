# Enforce LF line endings for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Enforce LF for config files
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.gz binary
*.tar binary
*.zip binary
