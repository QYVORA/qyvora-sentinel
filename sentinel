_generate_report_to_file() {
    local -r filepath="${1}"
    local -r format="${2:-text}"

    log_info "Writing ${format} report to ${filepath}"
    _generate_report "${format}" > "${filepath}"
    print_success "Report written to ${filepath}"
}

cmd_report() {
    local format="${SENTINEL_CLI_ARGS[format]:-text}"

    # Try to load the last scan file if no findings in memory
    if [[ ${#SENTINEL_FINDINGS[@]} -eq 0 ]]; then
        local latest_scan
        latest_scan="$(ls -t "${SENTINEL_REPORT_DIR}"/scan-*.json 2>/dev/null | head -1 || true)"
        if [[ -n "${latest_scan}" ]]; then
            log_info "Loading findings from ${latest_scan}"
            SENTINEL_LAST_SCAN_FILE="${latest_scan}"
        else
            log_error "No scan results found. Run 'sentinel scan' first."
            return 1
        fi
    fi

    print_header "Generating Report"

    if [[ -n "${SENTINEL_CLI_ARGS[output]:-}" ]]; then
        _generate_report_to_file "${SENTINEL_CLI_ARGS[output]}" "${format}"
    else
        _generate_report "${format}"
    fi

    return 0
}

# ---------------------------------------------------------------------------
# SUBCOMMAND: doctor
# ---------------------------------------------------------------------------
cmd_doctor() {
    print_header "System Doctor"
    echo ""

    local errors=0
    local warnings=0

    # Required commands
    echo "  ${SENTINEL_COLOR_BOLD}Required Commands:${SENTINEL_COLOR_RESET}"
    local required_commands=(bash find ps cat grep awk sed chmod chown id whoami uname ls file stat)
    local cmd
    for cmd in "${required_commands[@]}"; do
        if command_exists "${cmd}"; then
            print_success "${cmd}: $(command -v "${cmd}")"
        else
            print_error "${cmd}: NOT FOUND"
            errors=$((errors + 1))
        fi
    done

    # At least one of ss/netstat
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Network Commands:${SENTINEL_COLOR_RESET}"
    if command_exists ss; then
        print_success "ss: $(command -v ss)"
    elif command_exists netstat; then
        print_success "netstat: $(command -v netstat)"
    else
        print_error "ss/netstat: NEITHER FOUND"
        errors=$((errors + 1))
    fi

    # Hash commands
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Hash Commands:${SENTINEL_COLOR_RESET}"
    if command_exists sha256sum; then
        print_success "sha256sum: $(command -v sha256sum)"
    elif command_exists shasum; then
        print_success "shasum: $(command -v shasum)"
    else
        print_warning "sha256sum/shasum: NOT FOUND (optional but recommended)"
        warnings=$((warnings + 1))
    fi

    if command_exists md5sum; then
        print_success "md5sum: $(command -v md5sum)"
    else
        print_warning "md5sum: NOT FOUND (optional)"
        warnings=$((warnings + 1))
    fi

    # Optional commands
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Optional Commands:${SENTINEL_COLOR_RESET}"
    local optional_commands=(docker kubectl systemctl journalctl iptables nftables ufw fail2ban-client)
    for cmd in "${optional_commands[@]}"; do
        if command_exists "${cmd}"; then
            print_success "${cmd}: $(command -v "${cmd}")"
        else
            print_info "${cmd}: not installed (optional)"
        fi
    done

    # Configuration
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Configuration:${SENTINEL_COLOR_RESET}"
    local config_file="${SENTINEL_CLI_ARGS[config]:-}"
    if [[ -n "${config_file}" ]]; then
        if [[ -f "${config_file}" ]]; then
            print_success "Config file: ${config_file}"
        else
            print_error "Config file not found: ${config_file}"
            errors=$((errors + 1))
        fi
    else
        local default_config="${XDG_CONFIG_HOME:-${HOME}/.config}/qyvora-sentinel/sentinel.conf"
        if [[ -f "${default_config}" ]]; then
            print_success "Config file: ${default_config}"
        else
            print_info "No config file found (using defaults)"
        fi
    fi

    # Report directory
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Directories:${SENTINEL_COLOR_RESET}"
    if [[ -d "${SENTINEL_REPORT_DIR}" ]] && [[ -w "${SENTINEL_REPORT_DIR}" ]]; then
        print_success "Report directory: ${SENTINEL_REPORT_DIR} (writable)"
    elif [[ -d "${SENTINEL_REPORT_DIR}" ]]; then
        print_error "Report directory: ${SENTINEL_REPORT_DIR} (NOT WRITABLE)"
        errors=$((errors + 1))
    else
        print_warning "Report directory: ${SENTINEL_REPORT_DIR} (will be created)"
        warnings=$((warnings + 1))
    fi

    if [[ -d "${SENTINEL_BASELINE_DIR}" ]]; then
        print_success "Baseline directory: ${SENTINEL_BASELINE_DIR}"
    else
        print_warning "Baseline directory: ${SENTINEL_BASELINE_DIR} (will be created)"
        warnings=$((warnings + 1))
    fi

    # Modules
    echo ""
    echo "  ${SENTINEL_COLOR_BOLD}Modules:${SENTINEL_COLOR_RESET}"
    _discover_modules
    local module_count=${#SENTINEL_MODULE_REGISTRY[@]}
    if [[ "${module_count}" -gt 0 ]]; then
        print_success "${module_count} module(s) found"
    else
        print_warning "No modules found"
        warnings=$((warnings + 1))
    fi

    # Summary
    echo ""
    print_separator
    if [[ "${errors}" -gt 0 ]]; then
        echo -e "  ${SENTINEL_COLOR_RED}${SENTINEL_COLOR_BOLD}Doctor found ${errors} error(s) and ${warnings} warning(s)${SENTINEL_COLOR_RESET}"
        return 1
    elif [[ "${warnings}" -gt 0 ]]; then
        echo -e "  ${SENTINEL_COLOR_YELLOW}Doctor found ${warnings} warning(s) - system is functional${SENTINEL_COLOR_RESET}"
        return 0
    else
        echo -e "  ${SENTINEL_COLOR_GREEN}${SENTINEL_COLOR_BOLD}System looks healthy!${SENTINEL_COLOR_RESET}"
        return 0
    fi
}

