}

# ---------------------------------------------------------------------------
# Main entry point
# ---------------------------------------------------------------------------
main() {
    # If no arguments, show help
    if [[ $# -eq 0 ]]; then
        cmd_help
        exit 0
    fi

    # Parse global options
    SENTINEL_REMAINING_ARGS=""
    parse_global_options "$@"

    # Set up output mode based on parsed options
    _setup_output_mode

    # Split remaining args into subcommand and subcommand args
    local subcommand=""
    local subcommand_args=()

    if [[ -n "${SENTINEL_REMAINING_ARGS}" ]]; then
        subcommand="$(echo "${SENTINEL_REMAINING_ARGS}" | head -1)"
        while IFS= read -r line; do
            subcommand_args+=("${line}")
        done < <(echo "${SENTINEL_REMAINING_ARGS}" | tail -n +2)
    fi

    # Dispatch to subcommand
    case "${subcommand}" in
        scan)
            cmd_scan "${subcommand_args[@]+"${subcommand_args[@]}"}"
            ;;
        baseline)
            cmd_baseline "${subcommand_args[@]+"${subcommand_args[@]}"}"
            ;;
        compare)
            cmd_compare "${subcommand_args[@]+"${subcommand_args[@]}"}"
            ;;
        modules|module|list)
            cmd_modules
            ;;
        report)
            cmd_report "${subcommand_args[@]+"${subcommand_args[@]}"}"
            ;;
        doctor|check)
            cmd_doctor
            ;;
        version|ver|-V)
            cmd_version
            ;;
        update|upgrade)
            cmd_update
            ;;
        plugins|plugin)
            cmd_plugins "${subcommand_args[@]+"${subcommand_args[@]}"}"
            ;;
        help|--help|-h)
            cmd_help
            ;;
        "")
            cmd_help
            exit 0
            ;;
        *)
            echo "ERROR: Unknown command: ${subcommand}" >&2
            echo "" >&2
            echo "Run 'sentinel help' for usage information." >&2
            exit 1
            ;;
    esac

    return $?
}

main "$@"
