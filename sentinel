# SUBCOMMAND: help
# ---------------------------------------------------------------------------
cmd_help() {
    cat << 'HELPEOF'
QYVORA Sentinel - Linux Security Auditing Framework

Usage:
  sentinel [global-options] <command> [command-options]

Commands:
  scan              Run all enabled scan modules
  baseline [NAME]   Create a baseline snapshot (default: "default")
  compare           Compare current state to last baseline
  modules           List all available modules
  report            Generate report from last scan results
  doctor            Check system dependencies and configuration
  version           Display version information
  update            Check for updates
  plugins           List/manage plugins
  help              Display this help message

Global Options:
  -m, --module NAME     Run a specific module (repeatable)
  -e, --exclude MODULE  Exclude a module (repeatable)
  -I, --include MODULE  Include only these modules (repeatable)
  -s, --severity LEVEL  Minimum severity (INFO|LOW|MEDIUM|HIGH|CRITICAL)
  -o, --output FILE     Write output to file
  -c, --config FILE     Use custom configuration file
  -b, --baseline NAME   Baseline name for compare
      --compare         Enable comparison mode
  -t, --threads N       Number of parallel threads
      --risk-score      Display risk score
  -q, --quiet           Suppress non-essential output
  -v, --verbose         Enable verbose output
      --debug           Enable debug output (set -x)
      --json            Output in JSON format
      --html            Output in HTML format
      --markdown        Output in Markdown format
      --text            Output in text format (default)
      --color           Force colored output
      --no-color        Disable colored output
  -h, --help            Show this help message
  -V, --version         Show version information

Examples:
  sentinel scan
  sentinel scan --module filesystem --module ssh
  sentinel scan --severity medium --json --output report.json
  sentinel scan --exclude malware --risk-score
  sentinel baseline production
  sentinel compare --baseline production
  sentinel modules
  sentinel report --html --output report.html
  sentinel doctor
  sentinel version

Module Development:
  Modules live in modules/<name>/main.sh and must export:

    MODULE_NAME="mymodule"
    MODULE_DESCRIPTION="What this module checks"
    MODULE_SEVERITY_THRESHOLD="INFO"

    run() {
        # Your scan logic here
        # Use add_finding MODULE "message" SEVERITY to record findings
        add_finding "example" "Something concerning was found" "high"
    }

