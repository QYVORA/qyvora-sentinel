    local format="${1:-text}"

    if [[ ${#SENTINEL_FINDINGS[@]} -eq 0 ]]; then
        log_warning "No findings to report"
        return 0
    fi

    case "${format}" in
        json)
            _get_findings_json
            ;;
        markdown|md)
            echo "# QYVORA Sentinel Scan Report"
            echo ""
            echo "**Date:** $(date -u '+%Y-%m-%d %H:%M:%S UTC')"
            echo "**Hostname:** $(hostname 2>/dev/null || echo unknown)"
            echo "**Risk Score:** ${SENTINEL_RISK_SCORE}/100"
            echo ""
            echo "## Findings Summary"
            echo ""
            echo "| Severity | Count |"
            echo "|----------|-------|"
            echo "| CRITICAL | ${SENTINEL_FINDING_COUNTS[CRITICAL]:-0} |"
            echo "| HIGH     | ${SENTINEL_FINDING_COUNTS[HIGH]:-0} |"
            echo "| MEDIUM   | ${SENTINEL_FINDING_COUNTS[MEDIUM]:-0} |"
            echo "| LOW      | ${SENTINEL_FINDING_COUNTS[LOW]:-0} |"
            echo "| INFO     | ${SENTINEL_FINDING_COUNTS[INFO]:-0} |"
            echo ""
            echo "## Findings"
            echo ""
            for finding in "${SENTINEL_FINDINGS[@]+"${SENTINEL_FINDINGS[@]}"}"; do
                IFS='|' read -r sev mod msg detail ts <<< "${finding}"
                echo "- **[${sev}]** (${mod}) ${msg}"
                if [[ -n "${detail}" ]]; then
                    echo "  - ${detail}"
                fi
            done
            ;;
        html)
            cat <<HTMLEOF
