# ---------------------------------------------------------------------------
# SUBCOMMAND: update
# ---------------------------------------------------------------------------
cmd_update() {
    print_header "Checking for Updates"
    echo ""

    echo "  Current version: ${SENTINEL_VERSION}"
    echo "  Build date:      ${SENTINEL_BUILD_DATE}"
    echo ""

    # Check if we're in a git repo
    if [[ -d "${PROJECT_ROOT}/.git" ]]; then
        local remote_url current_branch
        remote_url="$(git -C "${PROJECT_ROOT}" remote get-url origin 2>/dev/null || echo "")"
        current_branch="$(git -C "${PROJECT_ROOT}" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"

        if [[ -n "${remote_url}" ]]; then
            echo "  Repository: ${remote_url}"
            echo "  Branch:     ${current_branch}"
            echo ""

            log_info "Fetching latest changes..."
            if git -C "${PROJECT_ROOT}" fetch origin 2>/dev/null; then
                local local_hash remote_hash
                local_hash="$(git -C "${PROJECT_ROOT}" rev-parse HEAD 2>/dev/null || echo "")"
                remote_hash="$(git -C "${PROJECT_ROOT}" rev-parse "origin/${current_branch}" 2>/dev/null || echo "")"

                if [[ "${local_hash}" == "${remote_hash}" ]]; then
                    print_success "Already up to date!"
                elif [[ -n "${remote_hash}" ]]; then
                    local behind
                    behind="$(git -C "${PROJECT_ROOT}" rev-list HEAD.."origin/${current_branch}" --count 2>/dev/null || echo "?")"
                    print_warning "Update available: ${behind} commit(s) behind"
                    echo ""
                    echo "  To update, run:"
                    echo "    cd ${PROJECT_ROOT}"
                    echo "    git pull origin ${current_branch}"
                fi
            else
                print_warning "Could not fetch from remote"
            fi
        else
            print_info "No remote configured. Cannot check for updates."
        fi
    else
        print_info "Not a git repository. Cannot check for updates automatically."
        echo ""
        echo "  Visit https://github.com/qyvora/sentinel for the latest version."
    fi

    return 0
}

# ---------------------------------------------------------------------------
# SUBCOMMAND: plugins
# ---------------------------------------------------------------------------
cmd_plugins() {
    local plugins_dir="${PROJECT_ROOT}/plugins"

    print_header "Plugins"
    echo ""

    if [[ ! -d "${plugins_dir}" ]]; then
        echo "  Plugins directory not found."
        echo ""
        echo "  Plugins can be placed in: ${plugins_dir}/"
        echo "  Each plugin should be a directory containing a main.sh file."
        return 0
    fi

    local plugin_count=0
    local plugin_dir

    for plugin_dir in "${plugins_dir}"/*/; do
        [[ ! -d "${plugin_dir}" ]] && continue
        local plugin_name
        plugin_name="$(basename "${plugin_dir}")"
        local plugin_main="${plugin_dir}main.sh"

        if [[ -f "${plugin_main}" ]]; then
            local plugin_desc=""
            plugin_desc="$(grep -E '^(readonly )?PLUGIN_DESCRIPTION=' "${plugin_main}" 2>/dev/null | head -1 | sed 's/^readonly //' | cut -d= -f2- | tr -d '"' || true)"
            print_success "${plugin_name}: ${plugin_desc:-No description}"
            plugin_count=$((plugin_count + 1))
        else
            print_warning "${plugin_name}: missing main.sh"
        fi
    done

    if [[ "${plugin_count}" -eq 0 ]]; then
        echo "  No plugins installed."
        echo ""
        echo "  Plugins extend QYVORA Sentinel with additional capabilities."
        echo "  Place plugin directories in: ${plugins_dir}/"
    else
        echo ""
        echo "  Total plugins: ${plugin_count}"
    fi

    return 0
}

